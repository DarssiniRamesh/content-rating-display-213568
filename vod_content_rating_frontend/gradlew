#!/usr/bin/env sh
set -eu

WRAPPER_JAR="gradle/wrapper/gradle-wrapper.jar"

# Ensure wrapper jar exists (placeholder may exist in analysis environments)
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Gradle wrapper jar not found at $WRAPPER_JAR."
  echo "Please run fetch-wrapper.sh or use the repository-root wrapper."
  exit 1
fi

# Locate Java
if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_CMD="$JAVA_HOME/bin/java"
else
  JAVA_CMD="java"
fi

exec "$JAVA_CMD" -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
