<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Text appearances wired to fonts -->
    <style name="TextAppearance.EG.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/inter_semi_bold</item>
        <item name="android:textColor">@color/eg_text</item>
    </style>

    <style name="TextAppearance.EG.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/eg_text</item>
    </style>

    <style name="TextAppearance.EG.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/eg_surface</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Aliases used by existing layouts/debug resources -->
    <style name="EG.Title" parent="TextAppearance.EG.Title"/>
    <style name="EG.Body" parent="TextAppearance.EG.Body"/>
    <style name="EG.Button.Primary" parent="Widget.EG.Button.Primary"/>

    <!-- Backwards-compat alias for legacy style reference used in activity_main.xml -->
    <style name="Widget.Executive.Button.Primary" parent="Widget.EG.Button.Primary"/>
</resources>
