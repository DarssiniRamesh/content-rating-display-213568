<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ratingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eg_background">

    <!-- Poster background -->
    <ImageView
        android:id="@+id/posterBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/accessibility_illustration"
        android:src="@android:color/darker_gray" />

    <!-- Gray overlay -->
    <View
        android:id="@+id/grayOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000" />

    <!-- Foreground card with PIP player, title, copy, and actions -->
    <LinearLayout
        android:id="@+id/foregroundCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:orientation="vertical">

        <!-- Small player surface (placeholder) -->
        <FrameLayout
            android:id="@+id/pipPlayerSurface"
            android:layout_width="200dp"
            android:layout_height="112dp"
            android:background="@color/eg_surface"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@+id/buttonDislike"
            android:contentDescription="@string/title_playback"
            android:padding="8dp" />

        <!-- Single-line title (show key name if missing; space if empty) -->
        <TextView
            android:id="@+id/contentTitle"
            style="@style/EG.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="16dp"
            android:text="" />

        <!-- Invitation copy -->
        <TextView
            android:id="@+id/invitationCopy"
            style="@style/EG.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="4dp" />

        <!-- Countdown -->
        <TextView
            android:id="@+id/countdownText"
            style="@style/EG.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10"
            android:layout_marginTop="8dp" />

        <!-- Buttons row -->
        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="24dp"
            android:baselineAligned="false">

            <Button
                android:id="@+id/buttonLike"
                style="@style/EG.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/rating_like"
                android:focusable="true"
                android:nextFocusRight="@+id/buttonLove"
                android:nextFocusDown="@+id/buttonClose" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/buttonLove"
                style="@style/EG.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/rating_love"
                android:focusable="true"
                android:nextFocusLeft="@+id/buttonLike"
                android:nextFocusRight="@+id/buttonDislike"
                android:nextFocusDown="@+id/buttonClose" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/buttonDislike"
                style="@style/EG.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/rating_dislike"
                android:focusable="true"
                android:nextFocusLeft="@+id/buttonLove"
                android:nextFocusDown="@+id/buttonClose" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/buttonClose"
                style="@style/EG.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rating_close"
                android:focusable="true"
                android:nextFocusUp="@+id/buttonDislike"
                android:nextFocusLeft="@+id/buttonDislike" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
