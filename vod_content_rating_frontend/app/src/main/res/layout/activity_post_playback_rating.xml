<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ratingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eg_background">

    <!-- Dim backdrop -->
    <View
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- Centered card -->
    <LinearLayout
        android:id="@+id/foregroundCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/eg_space_lg"
        android:layout_marginEnd="@dimen/eg_space_lg"
        android:background="@color/eg_surface"
        android:elevation="@dimen/eg_card_elevation"
        android:padding="@dimen/eg_space_lg"
        android:orientation="vertical">

        <!-- Title row with icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ratingIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_info_eg"
                app:tint="@color/eg_primary"
                android:contentDescription="@string/content_rating_icon" />

            <TextView
                android:id="@+id/contentTitle"
                style="@style/EG.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eg_space_md"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/rating_title" />
        </LinearLayout>

        <!-- Static badge for preview; dynamic code may insert another badge below invitation -->
        <TextView
            android:id="@+id/ratingBadgeStatic"
            style="@style/EG.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_sm"
            android:paddingLeft="@dimen/eg_space_sm"
            android:paddingRight="@dimen/eg_space_sm"
            android:paddingTop="@dimen/eg_space_xs"
            android:paddingBottom="@dimen/eg_space_xs"
            android:text="@string/rating_label_pg13"
            android:textStyle="bold"
            android:textColor="@color/eg_surface"
            android:background="@color/eg_primary" />

        <!-- Description / invitation -->
        <TextView
            android:id="@+id/invitationCopy"
            style="@style/EG.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_md"
            android:text="@string/rating_invite" />

        <!-- Static descriptors header+list anchors (populated at runtime if provided) -->
        <TextView
            android:id="@+id/descriptorsHeader"
            style="@style/EG.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_md"
            android:text="@string/rating_descriptors_header"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/descriptorsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Static badge/code+label row (updated at runtime) -->
        <TextView
            android:id="@+id/ratingBadgeStatic"
            style="@style/EG.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_md"
            android:background="@color/eg_primary"
            android:paddingLeft="@dimen/eg_space_sm"
            android:paddingRight="@dimen/eg_space_sm"
            android:paddingTop="@dimen/eg_space_xs"
            android:paddingBottom="@dimen/eg_space_xs"
            android:text="@string/rating_badge_placeholder"
            android:textColor="@color/eg_surface" />

        <!-- Advisory body (populated at runtime) -->
        <TextView
            android:id="@+id/advisoryBody"
            style="@style/EG.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_sm"
            android:text="@string/rating_description_pg13" />

        <!-- Descriptors header and list -->
        <TextView
            android:id="@+id/descriptorsHeader"
            style="@style/EG.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_md"
            android:text="@string/rating_descriptors_header" />

        <LinearLayout
            android:id="@+id/descriptorsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Optional descriptors static container (populated dynamically in Activity) -->
        <LinearLayout
            android:id="@+id/descriptorsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Countdown row -->
        <LinearLayout
            android:id="@+id/countdownRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_md"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/countdownLabel"
                style="@style/EG.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/post_playback_rating_title" />

            <TextView
                android:id="@+id/countdownText"
                style="@style/EG.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eg_space_sm"
                android:text="10s" />
        </LinearLayout>

        <!-- Countdown hint -->
        <TextView
            android:id="@+id/countdownHelp"
            style="@style/EG.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_xs"
            android:text="@string/rating_countdown_help" />

        <!-- Actions -->
        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_lg"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLike"
                style="@style/Widget.EG.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/eg_space_sm"
                android:layout_weight="1"
                android:text="@string/rating_like"
                app:icon="@drawable/ic_like_placeholder"
                app:iconPadding="@dimen/eg_space_xs"
                app:iconTint="@color/eg_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLove"
                style="@style/Widget.EG.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eg_space_xs"
                android:layout_marginEnd="@dimen/eg_space_xs"
                android:layout_weight="1"
                android:text="@string/rating_love"
                app:icon="@drawable/ic_love_placeholder"
                app:iconPadding="@dimen/eg_space_xs"
                app:iconTint="@color/eg_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDislike"
                style="@style/Widget.EG.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eg_space_sm"
                android:layout_weight="1"
                android:text="@string/rating_dislike"
                app:icon="@drawable/ic_dislike_placeholder"
                app:iconPadding="@dimen/eg_space_xs"
                app:iconTint="@color/eg_surface" />
        </LinearLayout>

        <!-- Acknowledge / Close button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClose"
            style="@style/Widget.EG.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_lg"
            android:text="@string/rating_close"
            app:icon="@drawable/ic_close_eg"
            app:iconTint="@color/eg_text" />

    </LinearLayout>

</FrameLayout>
