<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/eg_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:background="@color/exec_surface"
        android:padding="24dp"
        android:elevation="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">

        <ImageView
            android:id="@+id/iconShield"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="@color/eg_primary"
            android:layout_gravity="center_horizontal"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/title"
            android:text="@string/vod_title_placeholder"
            android:textColor="@color/eg_text"
            android:textSize="20sp"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/ratingBadge"
            android:text="@string/rating_label_pg13"
            android:textColor="@color/eg_surface"
            android:background="@color/eg_primary"
            android:padding="8dp"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/description"
            android:text="@string/rating_description_pg13"
            android:textColor="@color/exec_text"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/acknowledgedNote"
            android:text="@string/acknowledged_note"
            android:textColor="@color/eg_success"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/acknowledgeBtn"
            style="@style/Widget.Executive.Button.Primary"
            android:text="@string/acknowledge"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
