<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/eg_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/indiceTitle"
            style="@style/EG.Title"
            android:text="@string/title_indice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/indiceBody"
            style="@style/EG.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/eg_surface"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/indiceSectionTitle"
                style="@style/EG.Title"
                android:text="@string/indice_intro_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/indiceSectionBody"
                style="@style/EG.Body"
                android:text="@string/indice_intro_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/ctaPrototype1"
                style="@style/EG.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/indice_cta1" />

            <TextView
                android:id="@+id/ctaHint"
                style="@style/EG.Body"
                android:textColor="@color/eg_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/indice_cta_hint" />

            <!-- Placeholders hidden at runtime but kept in layout for future extension -->
            <Button
                android:id="@+id/ctaPrototype2"
                style="@style/EG.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/indice_cta2"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/ctaPrototype3"
                style="@style/EG.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/indice_cta3"
                android:layout_marginTop="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
