<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/instruccionesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eg_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/eg_space_lg">

        <TextView
            android:id="@+id/instruccionesTitle"
            style="@style/EG.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_instrucciones" />

        <TextView
            android:id="@+id/instruccionesBody"
            style="@style/EG.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_md"
            android:text="@string/instrucciones_howto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonProceed"
            style="@style/Widget.EG.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eg_space_lg"
            android:text="@string/instrucciones_proceed" />

    </LinearLayout>
</ScrollView>
