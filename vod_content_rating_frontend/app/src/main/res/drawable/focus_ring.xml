<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFE500"/>
            <stroke android:width="3dp" android:color="#FFFFFF"/>
            <corners android:radius="8dp"/>
            <padding android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp"/>
        </shape>
    </item>
    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFD200"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#202020"/>
            <stroke android:width="2dp" android:color="#606060"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
