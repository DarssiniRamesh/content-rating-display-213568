<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#39393e"
    android:padding="48dp">

    <LinearLayout
        android:id="@+id/overscanContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tv_title_about"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:paddingBottom="24dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acerca de esta app de TV (demostración)"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_btn_back_to_index"
            android:textAllCaps="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/focus_ring"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />
    </LinearLayout>
</FrameLayout>
