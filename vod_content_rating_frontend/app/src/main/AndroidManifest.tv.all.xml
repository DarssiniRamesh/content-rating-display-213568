<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Leanback Launcher Activity -->
        <activity
            android:name="org.example.app.tv.TvIndexActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Instructions Activity -->
        <activity
            android:name="org.example.app.tv.TvInstructionsActivity"
            android:exported="false" />

        <!-- Alias for TV launcher -->
        <activity-alias
            android:name=".TvLauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="org.example.app.tv.TvIndexActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Alias for Mobile launcher to reach TV flow when needed -->
        <activity-alias
            android:name=".MobileLauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="org.example.app.tv.TvIndexActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
